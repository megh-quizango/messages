<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:fitsSystemWindows="true"
    tools:context=".ui.caller.CallerMoreActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#F0F0F0"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/caller_cad_more"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="normal" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="5dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/suggestedAppsSection"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:background="@drawable/bg_after_call_suggested_apps"
                android:padding="10dp">

                <TextView
                    android:id="@+id/textSuggestedApps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/callercad_suggested_apps"
                    android:textColor="#D7D7D7"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toStartOf="@id/textAdBadge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textAdBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_after_call_ad_badge"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/ad_label"
                    android:textColor="@color/white"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/suggestedAppsRow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textSuggestedApps">

                    <LinearLayout
                        android:id="@+id/suggestedCalendar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/imageSuggestedAppOne"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_after_call_suggested_icon"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_after_call_calendar"
                            app:tint="@null" />

                        <TextView
                            android:id="@+id/textSuggestedAppOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="@font/poppins"
                            android:text="@string/callercad_calendar_2025"
                            android:textColor="#D7D7D7"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/suggestedGallery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/imageSuggestedAppTwo"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_after_call_suggested_icon"
                            android:padding="9dp"
                            android:src="@drawable/ic_gallery"
                            app:tint="#3B78D8" />

                        <TextView
                            android:id="@+id/textSuggestedAppTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="@font/poppins"
                            android:text="@string/callercad_gallery_app"
                            android:textColor="#D7D7D7"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/moreMainView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_after_call_more_group"
                android:orientation="vertical"
                android:paddingHorizontal="2dp"
                android:paddingVertical="5dp">

                <include
                    android:id="@+id/actionReminder"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionAddCaller"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionMessages"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionSendMail"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionCalendar"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionWeb"
                    layout="@layout/include_caller_more_row" />

                <include
                    android:id="@+id/actionCallInfo"
                    layout="@layout/include_caller_more_row" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
