<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp"
    android:background="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <FrameLayout
            android:id="@+id/nativeIconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/nativeAdIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_icon"
                android:contentDescription="@string/ad_icon"
                android:padding="4dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/nativeAdLabel"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_ad_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ad"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/nativeAdHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/gen_native_ad_layout_text_2"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toStartOf="@+id/nativeAdCallToAction"
            app:layout_constraintStart_toEndOf="@+id/nativeIconContainer"
            app:layout_constraintTop_toTopOf="@+id/nativeIconContainer" />

        <TextView
            android:id="@+id/nativeAdBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/gen_native_ad_layout_text_3"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/nativeAdCallToAction"
            app:layout_constraintStart_toStartOf="@+id/nativeAdHeadline"
            app:layout_constraintTop_toBottomOf="@+id/nativeAdHeadline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nativeAdCallToAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="76dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/gen_native_ad_layout_text_5"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:iconPadding="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/nativeIconContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/nativeIconContainer" />

        <View
            android:id="@+id/viewNativeAdDivider"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="10dp"
            android:background="#D0D0D0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nativeAdHeadline"
            app:layout_constraintTop_toBottomOf="@+id/nativeAdBody" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
